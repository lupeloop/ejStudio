{
  "name": "ejstudio",
  "productName": "ejStudio",
  "version": "3.2.2",
  "description": "ejStudio - log analyzer, tuning tool and live logger (ejLogger)",
  "author": "Teddy",
  "main": "main.js",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "test:logger": "node ejLogger/engine/test/golden.test.js && node ejLogger/engine/test/engine.test.js",
    "dist:mac": "node bundle.js && electron-builder --mac --publish never"
  },
  "build": {
    "appId": "com.ejstudio.app",
    "productName": "ejStudio",
    "files": [
      "main.js",
      "preload.js",
      "ejstudio.html",
      "logos/ejstudio.ico",
      "ejLogger/engine/engine.js",
      "ejLogger/engine/src/**",
      "package.json",
      "ejLogger/defaults/**",
      "ejLogger/ui/**",
      "ejLogger/phone.js",
      "logos/ejlogger_*.png",
      "logos/ejstudio_512.png"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "logos/ejstudio.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "logos/ejstudio.ico",
      "uninstallerIcon": "logos/ejstudio.ico",
      "installerHeaderIcon": "logos/ejstudio.ico",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/installerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp",
      "createDesktopShortcut": true,
      "runAfterFinish": true,
      "artifactName": "ejStudio-Setup-${version}.exe",
      "deleteAppDataOnUninstall": false,
      "shortcutName": "ejStudio",
      "include": "build/installer.nsh",
      "guid": "d46c0fde-f96e-5679-8aa4-560e9a48ad86"
    },
    "fileAssociations": [
      {
        "ext": [
          "ejsp",
          "ejstudio",
          "ejlab"
        ],
        "name": "ejStudio Project",
        "description": "ejStudio project"
      }
    ],
    "npmRebuild": false,
    "asarUnpack": [
      "node_modules/@serialport/**",
      "ejLogger/defaults/*.xml"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "logos/ejstudio_512.png",
      "category": "public.app-category.utilities",
      "identity": null,
      "artifactName": "ejStudio-Setup-${version}-${arch}.${ext}",
      "darkModeSupport": true,
      "extendInfo": {
        "NSLocalNetworkUsageDescription": "ejLogger serves the phone panel on the local network.",
        "NSBonjourServices": [
          "_http._tcp"
        ]
      }
    },
    "dmg": {
      "title": "ejStudio ${version}",
      "contents": [
        {
          "x": 150,
          "y": 190
        },
        {
          "x": 390,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  },
  "devDependencies": {
    "electron": "38.2.0",
    "electron-builder": "26.0.12",
    "resedit": "2.0.3"
  },
  "dependencies": {
    "serialport": "13.0.0"
  }
}
